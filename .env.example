# Local configuration template for live Polymarket testing.
# Copy to .env.local and fill locally. Do not commit .env.local.

# Polymarket CLOB credentials.
# POLY_PRIVATE_KEY must be the owner/session signer for the Polymarket account.
# It should recover the signer address shown in Settings -> Relayer API, not a random wallet.
POLY_PRIVATE_KEY=0x...
POLY_API_KEY=...
POLY_API_SECRET=...
POLY_PASSPHRASE=...

# Maker/funder wallet used by the CLOB order.
# For older Magic/proxy accounts this may be the profile/proxy wallet.
# For CLOB v2 deposit-wallet accounts, do NOT put RELAYER_API_KEY_ADDRESS here.
# Use POLY_DEPOSIT_WALLET_ADDRESS below; it will override this and force signature type 3.
POLY_FUNDER_ADDRESS=0x...

# Defaults for Polymarket Polygon CLOB.
POLY_CLOB_HOST=https://clob.polymarket.com
POLY_CHAIN_ID=137

# Signature type:
# 0 = EOA/browser wallet
# 1 = Polymarket proxy wallet
# 2 = Polymarket Gnosis Safe
# 3 = EIP-1271 / deposit-wallet style smart-contract signatures
# If POLY_DEPOSIT_WALLET_ADDRESS is set, the bot forces this to 3.
POLY_SIGNATURE_TYPE=1

# Optional Polygon RPC URL used by viem wallet clients.
POLY_RPC_URL=https://polygon-bor-rpc.publicnode.com

# Live stake safety/state.
# If --stake is omitted in live mode, the bot uses pUSD balance minus this buffer.
# If --stake is provided, the bot uses min(--stake, pUSD balance minus this buffer).
POLY_USE_LIVE_BALANCE=true
POLY_BALANCE_BUFFER=0.02
POLY_LEDGER_FILE=data/live-ledger.json

# Optional ordinary network proxy.
HTTP_PROXY=http://127.0.0.1:10808
HTTPS_PROXY=http://127.0.0.1:10808

# Live smoke/run parameters.
LIVE_STAKE=5
LIVE_ORDER_TYPE=FOK
LIVE_MATCH_FILE=tmp/live-match.json

# Deposit wallet / relayer flow, only needed if CLOB v2 returns:
# "maker address not allowed, please use the deposit wallet flow".
# Fill POLY_DEPOSIT_WALLET_ADDRESS with the account wallet/proxy/deposit wallet
# that holds pUSD. RELAYER_API_KEY_ADDRESS is only the relayer signer address.
POLY_RELAYER_URL=
POLY_RELAYER_API_KEY=
POLY_RELAYER_API_KEY_ADDRESS=
POLY_DEPOSIT_WALLET_ADDRESS=
POLY_SYNC_BALANCE_ALLOWANCE=false
