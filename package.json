{
  "name": "poly-fifa-2026-tail-spread-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Polymarket World Cup single-match spread tail-entry detector and paper/live executor.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "cli": "tsx src/cli.ts",
    "collect": "tsx src/collector/cli.ts collect",
    "collect:export": "tsx src/collector/cli.ts export",
    "collect:tennis": "tsx src/collector/cli.ts collect --tag-id 864 --sports tennis --date-window game-start",
    "research": "tsx src/research/cli.ts",
    "research:download": "tsx src/research/cli.ts download",
    "research:backtest": "tsx src/research/cli.ts backtest",
    "paper:fixture": "tsx src/cli.ts --mode paper --match-file tests/fixtures/matches/spain-5-0.json --markets-file tests/fixtures/markets/spain-spreads.json --orderbook-file tests/fixtures/orderbooks/spain-2p5-ask-097.json --stake 97",
    "live:status": "tsx src/cli.ts --mode status",
    "live:watch:worldcup": "tsx src/cli.ts --mode live --watch true --worldcup true --order-type FAK",
    "live:smoke": "BOT_MODE=live tsx src/cli.ts --mode live --match-file tests/fixtures/matches/spain-5-0.json --markets-file tests/fixtures/markets/spain-spreads.json --orderbook-file tests/fixtures/orderbooks/spain-2p5-ask-097.json --stake 5 --order-type FOK"
  },
  "dependencies": {
    "@polymarket/clob-client-v2": "^1.0.6",
    "undici": "^8.5.0",
    "viem": "^2.53.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "overrides": {
    "ws": "8.21.0"
  }
}
